"""LangGraph Central Multi-Agent Orchestration Graph for LexAgent AI."""
from __future__ import annotations
import time, uuid
from typing import Dict, Any
from langgraph.graph import StateGraph, START, END

from lexagent_ai.orchestrator.state import AgentState
from lexagent_ai.orchestrator.routing import (
    determine_workflow_type,
    route_initial_step,
    route_verification_gate
)
from lexagent_ai.agents.document_agent import DocumentIntelligenceAgent
from lexagent_ai.agents.legal_analysis_agent import LegalAnalysisAgent
from lexagent_ai.agents.research_agent import LegalResearchAgent
from lexagent_ai.agents.case_comparison_agent import CaseComparisonAgent
from lexagent_ai.agents.reasoning_agent import CaseReasoningAgent
from lexagent_ai.agents.drafting_agent import LegalDraftingAgent
from lexagent_ai.agents.verification_agent import VerificationAgent
from lexagent_ai.agents.report_agent import ReportGenerationAgent

# Instantiate 8 Agents
doc_agent = DocumentIntelligenceAgent()
analysis_agent = LegalAnalysisAgent()
research_agent = LegalResearchAgent()
comparison_agent = CaseComparisonAgent()
reasoning_agent = CaseReasoningAgent()
drafting_agent = LegalDraftingAgent()
verification_agent = VerificationAgent()
report_agent = ReportGenerationAgent()

def build_lexagent_graph():
    """Builds and compiles the full LangGraph state machine."""
    builder = StateGraph(AgentState)

    # 1. Add Graph Nodes (Agents)
    builder.add_node("plan_task", node_plan_task)
    builder.add_node("document_intelligence", node_document_intelligence)
    builder.add_node("legal_analysis", node_legal_analysis)
    builder.add_node("autonomous_research", node_autonomous_research)
    builder.add_node("case_comparison", node_case_comparison)
    builder.add_node("case_reasoning", node_case_reasoning)
    builder.add_node("legal_drafting", node_legal_drafting)
    builder.add_node("verification_gate", node_verification_gate)
    builder.add_node("report_generation", node_report_generation)

    # 2. Add Edges & Conditional Routing
    builder.add_edge(START, "plan_task")
    builder.add_conditional_edges("plan_task", route_initial_step)
    builder.add_edge("document_intelligence", "legal_analysis")
    builder.add_edge("legal_analysis", "autonomous_research")
    builder.add_edge("autonomous_research", "case_comparison")
    builder.add_edge("case_comparison", "case_reasoning")
    builder.add_edge("case_reasoning", "legal_drafting")
    builder.add_edge("legal_drafting", "verification_gate")

    # 3. Quality Gate & Self-Correction Reflection Loop (Confidence >= 0.85)
    builder.add_conditional_edges(
        "verification_gate",
        route_verification_gate,
        {
            "report_generation": "report_generation",
            "autonomous_research": "autonomous_research",  # Self-correction loop
            "END": END
        }
    )
    builder.add_edge("report_generation", END)

    return builder.compile()
