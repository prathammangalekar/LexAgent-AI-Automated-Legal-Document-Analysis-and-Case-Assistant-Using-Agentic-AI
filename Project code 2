from typing import TypedDict, List, Dict, Any, Optional
from lexagent_ai.models.schemas import (
    ParsedDocument, LegalRiskAssessment, ResearchResult,
    CaseComparisonResult, IRACReasoningResult, LegalDraft,
    VerificationAudit, ComprehensiveLegalReport
)

class AgentState(TypedDict, total=False):
    case_id: str
    workflow_type: str
    user_request: str
    input_file_path: Optional[str]
    
    # Outputs filled progressively by each agent:
    extracted_document: Optional[ParsedDocument]       # Agent 1
    risk_assessment: Optional[LegalRiskAssessment]     # Agent 2
    research_result: Optional[ResearchResult]          # Agent 3
    comparison_result: Optional[CaseComparisonResult]  # Agent 4
    reasoning_result: Optional[IRACReasoningResult]    # Agent 5
    legal_draft: Optional[LegalDraft]                  # Agent 6
    verification_audit: Optional[VerificationAudit]    # Agent 7 (Sentinel)
    final_report: Optional[ComprehensiveLegalReport]   # Agent 8
    
    iteration_count: int
    execution_history: List[Dict[str, Any]]
    current_step: str
    errors: List[str]
