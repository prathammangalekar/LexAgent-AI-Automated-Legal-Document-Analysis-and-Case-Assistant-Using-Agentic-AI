
from fastapi import FastAPI, UploadFile, File
from fastapi.staticfiles import StaticFiles
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from lexagent_ai.orchestrator.workflow import LexAgentWorkflowEngine

app = FastAPI(title="LexAgent AI Web Platform", version="1.0.0")
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_methods=["*"], allow_headers=["*"])

engine = LexAgentWorkflowEngine()

@app.post("/api/analyze")
async def analyze_document(file: UploadFile = File(...)):
    """Receives legal contract -> triggers LangGraph multi-agent audit."""
    temp_path = f"uploads/{file.filename}"
    with open(temp_path, "wb") as f:
        f.write(await file.read())
        
    result = engine.run_workflow_a_document_analysis(temp_path)
    return result

@app.post("/api/research")
async def conduct_research(query: str):
    """Triggers Agent 3 & 4 for statutory & precedent research."""
    return engine.run_workflow_b_research(query)

# Mount frontend single page application
app.mount("/", StaticFiles(directory=".", html=True), name="static")
